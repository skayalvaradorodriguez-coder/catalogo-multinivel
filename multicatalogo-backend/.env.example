# Copia este archivo como ".env" y ajusta los valores si hace falta.

# Aplicación
PORT=3000
# dev = los errores incluyen "details" técnicos; prod = se ocultan.
APP_ENV=dev
# Clave para firmar los JWT (mínimo 16 caracteres). Cámbiala por una propia y no la subas a git.
JWT_SECRET=cambia-esta-clave-por-una-larga-y-secreta
# Orígenes del frontend permitidos por CORS (en APP_ENV=dev también se aceptan IPs de la red local).
CORS_ORIGINS=http://localhost:5173, http://127.0.0.1:5173
# Lo usan tanto docker-compose.yml como el backend en Go (config/db.go y config/redis.go).

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=multicatalogo
# En la nube (Neon) se usa una sola cadena; si existe, tiene prioridad sobre DB_*.
# DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Carpeta con la build del frontend para que el backend entregue también la app (solo en la nube).
# STATIC_DIR=../dist

# Redis (Fase 3). Si defines REDIS_URL, tiene prioridad sobre REDIS_ADDR.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0

# Fase 4: simulación de fallas para demostrar el ROLLBACK (reinicia el backend al cambiarlas).
# true = todos los checkouts fallan a mitad de la transacción.
SIMULAR_FALLA_CHECKOUT=false
# Segundos de espera antes del COMMIT (0 = sin pausa), para detener PostgreSQL a mitad.
CHECKOUT_PAUSA_SEGUNDOS=0
