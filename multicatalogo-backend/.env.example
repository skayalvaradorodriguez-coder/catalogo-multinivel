# Copia este archivo como ".env" y ajusta los valores si hace falta.
# Lo usan tanto docker-compose.yml como el backend en Go (config/db.go y config/redis.go).

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=multicatalogo

# Redis (Fase 3). Si defines REDIS_URL, tiene prioridad sobre REDIS_ADDR.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0

# Fase 4: simulación de fallas para demostrar el ROLLBACK (reinicia el backend al cambiarlas).
# true = todos los checkouts fallan a mitad de la transacción.
SIMULAR_FALLA_CHECKOUT=false
# Segundos de espera antes del COMMIT (0 = sin pausa), para detener PostgreSQL a mitad.
CHECKOUT_PAUSA_SEGUNDOS=0
